# OddSpot 環境變數範本
# 複製此檔成 .env.local 後填入實際值。.env.local 不會進 git。

# ─────────────────────────────────────────
# Mapbox（地圖路線 A 改造後使用）
# ─────────────────────────────────────────
# 申請流程：
#   1. mapbox.com 註冊
#   2. Account → Tokens
#   3. 取 Default public token（pk.eyJ...）
# 免費額度：5 萬載入/月，足夠 < 3000 月用戶規模
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_public_token_here

# ─────────────────────────────────────────
# Google Maps（地圖路線 A 改造階段 2 完成後可移除）
# ─────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ─────────────────────────────────────────
# Vercel Blob（投稿照片上傳）
# ─────────────────────────────────────────
# 在 Vercel Dashboard → Storage 建立 public Blob store 後取得。
# 只給 server route 使用，不要暴露成 NEXT_PUBLIC_。
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_token_here

# ─────────────────────────────────────────
# 資料庫（如果需要本地開發）
# ─────────────────────────────────────────
# DATABASE_URL=

# ─────────────────────────────────────────
# NextAuth（Step 5 才會啟用）
# ─────────────────────────────────────────
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=
